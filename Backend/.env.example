# ============================================================
# SERVER
# ============================================================

PORT=5000
NODE_ENV=development


# ============================================================
# MONGODB
# ============================================================

MONGO_URI=your_mongodb_connection_string


# ============================================================
# JWT AUTHENTICATION
# ============================================================

# Access token — short-lived (sent in Authorization header)
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=15m

# Refresh token — long-lived (sent as httpOnly cookie). MUST be a
# DIFFERENT secret from JWT_SECRET.
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRE=30d


# ============================================================
# ADMIN
# ============================================================

ADMIN_PIN=your_admin_pin


# ============================================================
# CLOUDINARY
# ============================================================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# ============================================================
# AI CHATBOT (GOOGLE GEMINI - FREE)
# ============================================================
# Get a free API key from https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key


# ============================================================
# CORS / FRONTEND
# ============================================================

FRONTEND_URL=http://localhost:5173


# ============================================================
# EMAIL NOTIFICATIONS (Nodemailer / SMTP)
# ============================================================
# Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=465
# Use a Gmail "App Password" for EMAIL_PASS, NOT your normal password.
# See utils/sendEmail.js for setup notes + a Resend alternative.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# Where contact-form notifications should be sent (defaults to EMAIL_USER)
ADMIN_NOTIFY_EMAIL=your_email@gmail.com

# Alternative to SMTP — only needed if using sendEmailViaResend()
# RESEND_API_KEY=your_resend_api_key


# ============================================================
# AUTOMATED MONGODB BACKUP
# ============================================================
# Set to "true" to auto-run backups on a schedule while the server
# is running (see utils/cronJobs.js). Standard cron syntax.

ENABLE_AUTO_BACKUP=false
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_RETENTION_COUNT=7